# Plantilla de las variables que la aplicacion necesita.
#
# Copiar como .env y rellenar. El .env real NUNCA se commitea: esta en
# .gitignore, y esta plantilla existe para no tener que pasarse valores reales
# por chat solo para saber que variables hacen falta.

# --- Base de datos ----------------------------------------------------------
# Los valores de ejemplo son los del compose.yaml del repositorio. Ojo con el
# puerto: el contenedor publica 5433 en el host para no chocar con un PostgreSQL
# instalado localmente, y solo en 127.0.0.1.
#
# DB_PASSWORD no tiene valor por defecto en el compose: si falta, docker compose
# se niega a arrancar y dice cual falta. Es deliberado — una contrasena por
# defecto como "postgres" es una credencial publica, y el dia que alguien exponga
# el puerto deja de ser un detalle de desarrollo. Poner cualquiera aqui, aunque
# sea local:  openssl rand -base64 24
DB_HOST=localhost
DB_PORT=5433
DB_NAME=check-out
DB_USER=postgres
DB_PASSWORD=

# --- JWT --------------------------------------------------------------------
# El secreto firma y verifica los tokens. Minimo 32 caracteres, porque HS256
# exige 256 bits. Generar uno nuevo con:
#   openssl rand -base64 48
# No reutilizar el de otro entorno: quien tenga esta clave puede emitirse un
# token valido para cualquier usuario.
JWT_SECRET=

# Vidas de los tokens, en formato ISO-8601 de duracion.
# El de acceso es corto porque viaja en cada peticion y no se puede revocar; el
# de refresco es largo pero vive en la base y si se revoca.
JWT_EXPIRATION_ACCESS=PT15M
JWT_EXPIRATION_REFRESH=P30D

# --- Correo -----------------------------------------------------------------
# Solo hacen falta para el servicio de correo. Sin ellas la aplicacion arranca
# igual y falla al intentar enviar, que es cuando corresponde.
# Con Gmail hay que usar una contrasena de aplicacion, no la del correo.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Datos de mercado (Alpaca) ----------------------------------------------
# Claves de https://app.alpaca.markets (cuenta paper). Son secretas: solo van
# aqui y en el gestor de secretos del despliegue, nunca en el frontend ni en git.
# Sin ellas la aplicacion arranca igual; el catalogo y los precios del proveedor
# responden 503 hasta configurarlas.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Esquema y logs ---------------------------------------------------------
# El esquema lo crean las migraciones de src/main/resources/db/migration, que
# Flyway aplica al arrancar. Hibernate solo lo valida: si no coincide con las
# entidades, la aplicacion no arranca en vez de tocar la base.
#
# Normalmente no hay que declarar nada de esto. Las dos variables de abajo van
# comentadas a proposito: una variable de entorno pisa al perfil, y ponerlas
# aqui es como se rompe un arranque limpio sin darse cuenta.
#
# DDL_AUTO solo se descomenta para pedir algo distinto a proposito, y con Flyway
# en marcha eso casi nunca hace falta. update deja que Hibernate decida los
# ALTER por su cuenta; create-drop borra el esquema al apagar. Para empezar de
# cero en local, lo correcto es borrar el volumen:
#   docker compose down -v && docker compose up --build
#
# DDL_AUTO=update

# Apaga Flyway. Solo tiene sentido si se apunta a una base cuyo esquema mantiene
# otro proceso. Con esto en false y ddl-auto en validate, una base vacia no
# arranca: no hay nadie que cree las tablas.
# FLYWAY_ENABLED=true

# Imprime cada consulta en el log. Util en local, ruido y fuga de datos fuera.
# El default es false; el perfil dev lo enciende.
SHOW_SQL=false

# --- Documentacion de la API -------------------------------------------------
# Swagger describe cada endpoint y su cuerpo. En produccion eso es un mapa para
# quien busque por donde entrar, asi que el default es false y el perfil dev lo
# enciende. Solo hace falta ponerla aqui para publicarla sin el perfil dev.
SWAGGER_ENABLED=false

# --- CORS -------------------------------------------------------------------
# Origenes del front, separados por coma. Tiene valor por defecto, asi que solo
# hace falta declararla cuando el front no corre en localhost.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
