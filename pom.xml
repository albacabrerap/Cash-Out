<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.checkout</groupId>
    <artifactId>Check-Out</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Check-Out</name>
    <description>Check-Out</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>

        <!--
          Third-party versions are pinned here. All were checked against the OSV
          database on 2026-09-20 and have no known advisories.

          Spring-managed artifacts (validation, mail, thymeleaf, data-jpa,
          security, webmvc) are deliberately NOT pinned: they inherit from the
          spring-boot-starter-parent 4.1.1 BOM, and overriding one of them
          breaks the version alignment the BOM guarantees.
        -->
        <jjwt.version>0.13.0</jjwt.version>
        <modelmapper.version>3.2.6</modelmapper.version>
        <springdoc.version>3.1.1</springdoc.version>
        <postgresql.version>42.7.13</postgresql.version>

        <!--
          Override of a BOM-managed version. Spring Boot 4.1.1 pins embedded
          Tomcat 11.0.24, which carries three CRITICAL advisories:
            GHSA-9xv2-5v5q-p794  DIGEST auth bypass
            GHSA-gcx9-497g-6cp6  improper access control
            GHSA-h3x4-894j-xpx5  FORM auth incorrect authorization
          All three are fixed in 11.0.25. Boot 4.1.1 is the newest stable
          release, so there is no upgrade that picks it up on its own.
          Remove this line once a Boot release ships 11.0.25 or later.
        -->
        <tomcat.version>11.0.25</tomcat.version>

        <!--
          The tests run in the business time zone (app.time-zone). Many build
          their data with LocalDate.now(), and if the JVM ran in UTC while the
          app decides "today" in Lima, they would fail every night between
          19:00 and midnight Lima time. Surefire reads this property; it can be
          overridden from the command line, e.g. -DargLine=-Duser.timezone=UTC.
        -->
        <argLine>-Duser.timezone=America/Lima</argLine>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Bean Validation: @Valid, @NotNull, @Email, @DecimalMin, @Future.
             Desde Spring Boot 3 ya no viene incluida en el starter web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Envio de correos (metas cumplidas, resumen mensual, alertas).
             Sin <version>: la fija el BOM de spring-boot-starter-parent, igual
             que el resto de artefactos de Spring. Fijarla a mano rompe la
             alineacion que el BOM garantiza, y mas aun con una M1, que es de
             preestreno y no encaja con el Boot 4.1.1 estable del proyecto.
             spring-context-support no hace falta declararlo: lo arrastra este
             starter, que es quien trae JavaMailSender. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Plantillas HTML para los correos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
          PostgreSQL JDBC driver. Still required with Docker: the container runs
          the database *server*, this is the *client* library the JVM needs to
          speak its wire protocol. spring-boot-starter-data-jpa brings Hibernate
          and HikariCP but no driver, so without this the app fails at startup
          with "Failed to determine a suitable driver class".
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Migraciones versionadas del esquema.

          Antes el esquema lo creaba Hibernate: comodo en local y sin respuesta
          para un despliegue. Con ddl-auto=validate una base nueva no arranca
          porque no hay nada que cree las tablas, y con update Hibernate decide
          por su cuenta que ALTER ejecutar sobre datos reales. Flyway cierra las
          dos puntas: el SQL esta escrito, versionado y revisado, corre una sola
          vez y queda registrado en flyway_schema_history.

          Son dos dependencias y ninguna sobra:

          - spring-boot-starter-flyway trae flyway-core Y la autoconfiguracion
            que lo ejecuta al arrancar. En Boot 4 esa autoconfiguracion vive en
            su propio modulo, igual que paso con webmvc y con data-jpa-test; con
            flyway-core a secas la libreria esta en el classpath y no corre
            nadie, que es un fallo silencioso: la aplicacion arranca, no aplica
            ninguna migracion y no dice nada.
          - flyway-database-postgresql porque desde Flyway 10 el soporte de cada
            motor va aparte, y sin el no reconoce PostgreSQL.

          La version la fija el BOM de Spring Boot (12.4.0 en Boot 4.1.1).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT propio: generacion y validacion de tokens -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Mapeo entidad <-> DTO -->
        <dependency>
            <groupId>org.modelmapper</groupId>
            <artifactId>modelmapper</artifactId>
            <version>${modelmapper.version}</version>
        </dependency>

        <!-- Documentacion OpenAPI / Swagger UI.
             La linea 3.x es la que soporta Spring Boot 4; la 2.x es para Boot 3. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--env -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Base en memoria solo para tests: deja que Hibernate genere el
             esquema de las 17 entidades y falle aqui si un mapeo esta mal.
             En ejecucion real se usa PostgreSQL. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
